# Pandablog production environment file.
# Copy to ".env" next to docker-compose.yml and fill in real values.
#
#   cp .env.example .env
#
# NOTE: Nuxt/Nitro reads these at runtime. The .env file in /opt/.../pandablog
# is read by the container via env_file. SURREAL_ROOT / SURREAL_ROOT_PASSWORD
# MUST match the SURREAL_USER / SURREAL_PASS used by the surrealdb container.

# --- SurrealDB connection -------------------------------------------------
# Both pandablog-app and surrealdb share the external "nginx" docker network,
# so the app reaches the DB by container name over plain ws:// (no TLS needed
# on the internal hop; TLS is terminated by nginx at the edge).
#
# IMPORTANT: at runtime Nitro only overrides runtimeConfig from NUXT_-prefixed
# env vars. Plain SURREAL_URL is read ONLY at build time, so the container
# would otherwise fall back to the baked default ws://127.0.0.1:8000/rpc.
NUXT_SURREAL_URL="ws://surrealdb:8000/rpc"
NUXT_SURREAL_NAMESPACE="main"
NUXT_SURREAL_DATABASE="main"
NUXT_SURREAL_ROOT="root"                 # must equal surrealdb's SURREAL_USER
NUXT_SURREAL_ROOT_PASSWORD="change-me"   # must equal surrealdb's SURREAL_PASS

# --- Scoped runtime user (optional, recommended) --------------------------
# When both are set, normal request traffic signs in as this least-privilege,
# DATABASE-scoped EDITOR user instead of root. Root is then used only at boot
# (to provision/update this user + run schema/migrations) and for backup/restore.
# The app auto-creates/updates the user at startup via DEFINE USER ... OVERWRITE,
# so rotating the password just means changing it here and restarting.
# Leave both blank to keep using root for runtime queries (previous behaviour).
# SURREAL_APP_USER must be a simple identifier (letters, digits, underscore).
# NUXT_SURREAL_APP_USER="pandablog_app"
# NUXT_SURREAL_APP_PASSWORD="change-me-too"

# --- Session encryption ---------------------------------------------------
# MUST be 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD="change-me-to-32-plus-random-chars"

# --- Two-factor authentication (TOTP) -------------------------------------
# Optional. Encrypts TOTP secrets at rest. If unset, NUXT_SESSION_PASSWORD is
# used instead. Rotating this value (or the session password when this is
# unset) invalidates all stored TOTP secrets and forces users to re-enrol.
# NUXT_MFA_SECRET="change-me-to-a-separate-strong-random-secret"

# --- Runtime tuning -------------------------------------------------------
# V8 old-space heap cap. Tune per host in the live .env file. 1024 MB is the
# current conservative value for a 2 GB server with co-located SurrealDB.
# NOTE: no NUXT_ prefix here — NODE_OPTIONS is read by the Node.js runtime
# itself (not Nitro's runtimeConfig), so the name is fixed by Node.
NODE_OPTIONS="--max-old-space-size=1024"

# --- GeoIP analytics (optional) -------------------------------------------
# Default path resolves to /app/storage/geoip/dbip-city-lite.mmdb inside the
# container. Only set this if you mount the DB somewhere else.
# NUXT_GEOIP_DB_PATH="storage/geoip/dbip-city-lite.mmdb"

# --- Image override (optional) --------------------------------------------
# PANDABLOG_IMAGE="localhost/pandablog:latest"
